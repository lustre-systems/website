<script is:inline>
(() => {
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* theme */
    const root = document.documentElement;
    const media = matchMedia('(prefers-color-scheme: dark)');
    const tbtn = $('.theme-toggle');
    const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : media.matches;
    const syncTheme = () => { root.classList.toggle('is-dark', isDark()); tbtn.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode'); };
    tbtn.addEventListener('click', () => { root.dataset.theme = isDark() ? 'light' : 'dark'; try { localStorage.setItem('lustre-theme', root.dataset.theme); } catch {} syncTheme(); });
    media.addEventListener('change', syncTheme);
    syncTheme();

    /* hero: start the phones' pop once the page has loaded (so nothing else is fighting for the main thread) and their images are decoded, or after 2.5 s regardless */
    const cluster = $('#cluster');
    const loaded = document.readyState === 'complete' ? Promise.resolve() : new Promise((ok) => addEventListener('load', ok, { once: true }));
    Promise.race([Promise.all([loaded, ...$$('.shot img', cluster).map((i) => i.decode().catch(() => {}))]), new Promise((ok) => setTimeout(ok, 2500))])
        .then(() => requestAnimationFrame(() => requestAnimationFrame(() => cluster.classList.add('go'))));

    /* the nav pill turns to dark glass while it's over the hero card */
    const nav = $('.nav'), hero = $('.hero');
    const navSync = () => nav.classList.toggle('over', hero.getBoundingClientRect().bottom > 70);
    addEventListener('scroll', navSync, { passive: true });
    navSync();

    /* reveals */
    const rio = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); rio.unobserve(e.target); } }), { threshold: 0.15 });
    $$('.reveal').forEach((el) => rio.observe(el));

    /* setup: the line fills with the scroll, and each step lights when the fill reaches it */
    const sline = $('#setupLine'), sitems = $$(':scope > li', sline);
    const setupScroll = () => {
        const mark = innerHeight * 0.55, r = sline.getBoundingClientRect();
        sline.style.setProperty('--p', Math.min(1, Math.max(0, (mark - r.top - 22) / (r.height - 44))));
        sitems.forEach((li) => li.classList.toggle('on', li.getBoundingClientRect().top + 22 <= mark));
    };
    addEventListener('scroll', setupScroll, { passive: true });
    addEventListener('resize', setupScroll);
    setupScroll();

    /* copy */
    $$('[data-copy]').forEach((btn) => btn.addEventListener('click', () => {
        const el = document.getElementById(btn.dataset.copy);
        const done = () => { btn.textContent = 'copied'; setTimeout(() => { btn.textContent = 'copy'; }, 1600); };
        const select = () => { const r = document.createRange(); r.selectNodeContents(el); const s = getSelection(); s.removeAllRanges(); s.addRange(r); };
        try { navigator.clipboard.writeText(el.textContent.trim()).then(done, select); } catch { select(); }
    }));

    /* the paper book: the taped page straightens into the Day screen, each line handing over to its row.
       It plays by itself the first time it's well in view; the link under it flips it either way. */
    {
        const stage = $('#pbStage'), face = $('.pb-face', stage), paper = $('.pb-paper', stage), app = $('.pb-app', stage);
        const canvas = $('.pb-canvas', stage), tapes = $$('.pb-tape', stage), fixes = $$('#pbFixes li');
        const toggle = $('#pbToggle'), remTab = $('[data-tab="rem"]', stage);
        const KEYS = ['head', 'nour', 'kareem', 'mona', 'laila', 'sara', 'rem'];
        const clamp = (v) => Math.max(0, Math.min(1, v)), lerp = (a, b, t) => a + (b - a) * t;
        const ease = (t) => 1 - Math.pow(1 - t, 3);
        const inout = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
        let deltas = new Map(), p = 0, lit = false;

        // How far each app element has to travel to start on its paper line, measured with nothing tilted.
        const measure = () => {
            const tilt = stage.style.rotate; stage.style.rotate = '0deg';
            deltas = new Map();
            $$('[data-k]', app).forEach((el) => {
                const was = el.style.transform; el.style.transform = '';
                const from = $(`[data-k="${el.dataset.k}"]`, paper);
                deltas.set(el, el.dataset.k === 'head' ? 0 : from.getBoundingClientRect().top - el.getBoundingClientRect().top);
                el.style.transform = was;
            });
            stage.style.rotate = tilt;
        };
        const set = (v) => {
            p = v;
            const t = inout(clamp(v / 0.6)), lift = clamp(v / 0.25);
            stage.style.rotate = `${lerp(-2.2, 0, t)}deg`;
            face.style.borderRadius = `${lerp(6, 28, t)}px`;
            canvas.style.opacity = ease(clamp((v - 0.1) / 0.45));
            tapes.forEach((tp, i) => { tp.style.opacity = 1 - lift; tp.style.translate = `${(i ? 20 : -20) * lift}px ${-16 * lift}px`; });
            const ts = {};
            KEYS.forEach((k, i) => {
                const tk = ease(clamp((v - 0.15 - (i / KEYS.length) * 0.6) / 0.3));
                ts[k] = tk;
                const line = $(`[data-k="${k}"]`, paper);
                line.style.opacity = 1 - tk;
                line.style.transform = `translateX(${-14 * tk}px)`;
                $$(`[data-k="${k}"]`, app).forEach((el) => {
                    el.style.opacity = tk;
                    el.style.transform = `translateY(${(deltas.get(el) || 0) * (1 - tk)}px)`;
                });
            });
            fixes.forEach((li) => li.classList.toggle('on', ts[li.dataset.k] > 0.6));
            if (ts.rem > 0.5 && !lit) { lit = true; remTab.classList.remove('lit'); void remTab.offsetWidth; remTab.classList.add('lit'); }
            if (ts.rem < 0.1) lit = false;
            stage.classList.toggle('on-app', v >= 1);
            stage.classList.toggle('on-paper', v <= 0);
        };

        let raf = 0, target = 0;
        const label = () => {
            toggle.innerHTML = target
                ? '<i class="ph ph-notebook"></i><span>Back to the paper book</span>'
                : '<span>See it in Lustre</span><i class="ph ph-arrow-right"></i>';
        };
        const play = (to, dur) => {
            target = to; label();
            cancelAnimationFrame(raf);
            if (reduce) { set(to); return; }
            const from = p, t0 = performance.now(), d = dur * Math.abs(to - from);
            if (!d) return;
            const step = (now) => { const k = Math.min(1, (now - t0) / d); set(from + (to - from) * k); if (k < 1) raf = requestAnimationFrame(step); };
            raf = requestAnimationFrame(step);
        };

        // Once someone has flipped it themselves it stays where they left it; until then it plays on
        // arrival and quietly resets once it's off screen, so it plays again next time.
        let touched = false, armed = true, timer = 0;
        const flip = () => { touched = true; clearTimeout(timer); play(target ? 0 : 1, 2400); };
        toggle.addEventListener('click', flip);
        face.addEventListener('click', () => { if (p <= 0.5 && target === 0) flip(); });
        new IntersectionObserver((es) => es.forEach((e) => {
            if (e.intersectionRatio >= 0.55 && armed && !touched) { armed = false; timer = setTimeout(() => play(1, 3200), 400); }
            if (!e.isIntersecting && !touched) { clearTimeout(timer); cancelAnimationFrame(raf); armed = true; target = 0; label(); set(0); }
        }), { threshold: [0, 0.55] }).observe(stage);

        measure(); set(0);
        const remeasure = () => { measure(); set(p); };
        addEventListener('resize', remeasure);
        document.fonts?.ready.then(remeasure);

        // The screen works once it's there: the tabs switch, and a sent or skipped reminder leaves.
        const tabs = $$('[data-tab]', stage), counts = $$('[data-count]', stage);
        tabs.forEach((b) => b.addEventListener('click', () => {
            tabs.forEach((t) => t.setAttribute('aria-selected', String(t === b)));
            $$('[data-pane]', stage).forEach((pane) => { pane.hidden = pane.dataset.pane !== b.dataset.tab; });
        }));
        $$('.pb-rm button', stage).forEach((b) => b.addEventListener('click', () => {
            const r = b.closest('.pb-rm');
            if (r.classList.contains('gone')) return;
            r.classList.add('gone');
            setTimeout(() => {
                r.remove();
                const left = $$('.pb-rm', stage).length;
                counts.forEach((c) => { c.textContent = left; });
                if (!left) $('.pb-empty', stage).hidden = false;
            }, 300);
        }));
    }

    /* phones spread as the hero scrolls away */
    if (!reduce) {
        let spreadQueued = false;
        const spread = () => {
            spreadQueued = false;
            const r = hero.getBoundingClientRect();
            cluster.style.setProperty('--spread', `${Math.min(1, Math.max(0, -r.top / r.height)) * 60}px`);
        };
        addEventListener('scroll', () => { if (!spreadQueued) { spreadQueued = true; requestAnimationFrame(spread); } }, { passive: true });
        spread();
    }

    /* touch screens have no hover, so each reason's tile plays once it's well in view */
    if (matchMedia('(hover: none)').matches) {
        const lio = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { setTimeout(() => e.target.classList.add('lit'), 500); lio.unobserve(e.target); } }), { threshold: 0.7 });
        $$('.reason').forEach((el) => lio.observe(el));
    }
})();
</script>
